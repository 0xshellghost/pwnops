# PwnOps — Environment Configuration

# Authentication Secret (Required)
# Use a strong, random 256-bit string in production.
# Example: openssl rand -base64 32
JWT_SECRET="replace_me_with_a_strong_secret_key"

# GitHub OAuth (Optional)
# Create an OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/github/callback"

# Google OAuth (Optional)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Application Environment (Optional)
# Set to "production" to enable strict security headers and caching
NODE_ENV="production"

# Database Configuration
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres"

# Note: PwnOps uses Prisma with PostgreSQL (Supabase) for data persistence.
# The DATABASE_URL above should point to your Supabase project's pooled connection string.

# ── Scan Worker Configuration ──────────────────────────────
# The scan worker runs as a separate process on a machine
# where security tools (nmap, testssl.sh, lynis) are installed.
#
# Start the worker with: npm run worker:scan
#
# Required tools (install on the worker host):
#   sudo apt install nmap         # Port scanning & host discovery
#   sudo apt install testssl.sh   # SSL/TLS auditing
#   sudo apt install lynis        # System hardening audit

# Poll interval in ms (default: 3000)
WORKER_POLL_INTERVAL=3000

# Max concurrent scans per worker instance (default: 3)
WORKER_MAX_CONCURRENT=3

# Set to "true" to block scans targeting private IP ranges (10.x, 172.16-31.x, 192.168.x)
BLOCK_PRIVATE_SCANS=false

# ── Seed Account Passwords (Optional) ─────────────────────
# These are used when the database is first seeded.
# If not set, strong defaults are used.
# SEED_ADMIN_PASSWORD="PwnOps!Admin#2026"
# SEED_ANALYST_PASSWORD="PwnOps!Analyst#2026"
# SEED_VIEWER_PASSWORD="PwnOps!Viewer#2026"
