# PwnOps — Environment Configuration

# Authentication Secret (Required)
# Use a strong, random 256-bit string in production.
# Example: openssl rand -base64 32
JWT_SECRET="replace_me_with_a_strong_secret_key"

# GitHub OAuth (Optional)
# Create an OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/github/callback"

# Google OAuth (Optional)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Application Environment (Optional)
# Set to "production" to enable strict security headers and caching
NODE_ENV="production"

# Note: PwnOps currently uses an in-memory datastore for demonstration purposes.
# In a real production environment, you would also define database connection strings here:
# DATABASE_URL="postgresql://user:password@localhost:5432/pwnops"
