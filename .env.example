# ──────────────────────────────────────────────────────────
# PwnOps — Environment Configuration
# ⚠ This file contains secrets. NEVER commit to git.
# ──────────────────────────────────────────────────────────

# ── Database (Required) ───────────────────────────────────
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres"

# ── Authentication (Required) ────────────────────────────
# 256-bit secret for signing JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="replace_me_with_a_strong_secret_key"

# Application Environment
# Set to "production" to enable HSTS, Secure cookies, and strict security headers
NODE_ENV="development"

# ── OAuth Providers (Optional) ───────────────────────────
# GitHub — Create an OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/github/callback"

# Google — Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ── Rate Limiting (Optional) ─────────────────────────────
# Upstash Redis for distributed sliding-window rate limiting.
# If not set, falls back to an in-memory rate limiter (suitable for single-instance deployments).
# Create a free database at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Email (Optional) ─────────────────────────────────────
# Resend API key for sending password reset and welcome emails.
# If not set, emails are logged to the console in development.
# Sign up at: https://resend.com/
RESEND_API_KEY=""

# ── App URL (Optional) ───────────────────────────────────
# Base URL used in email links (password reset, welcome emails).
# Defaults to http://localhost:3000 if not set.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Scan Worker Configuration ────────────────────────────
# The scan worker runs as a separate process on a machine
# where security tools (nmap, testssl.sh, lynis, etc.) are installed.
#
# Start the worker with: npm run worker:scan
#
# Required tools (install on the worker host):
#   sudo apt install nmap         # Port scanning & host discovery
#   sudo apt install testssl.sh   # SSL/TLS auditing
#   sudo apt install lynis        # System hardening audit

# Poll interval in ms (default: 3000)
WORKER_POLL_INTERVAL=3000

# Max concurrent scans per worker instance (default: 3)
WORKER_MAX_CONCURRENT=3

# Set to "true" to block scans targeting private IP ranges (10.x, 172.16-31.x, 192.168.x)
# ⚠ RECOMMENDED: Set to "true" in production to prevent internal network scanning
BLOCK_PRIVATE_SCANS=true

# URL of the deployed scan worker (Render/Railway/etc.)
# Example: https://pwnops-scan-worker.onrender.com
RENDER_WORKER_URL=""

# API key for authenticating requests between Next.js app and scan worker
# Generate with: openssl rand -hex 32
WORKER_API_KEY=""

# WebSocket URL for live scan progress updates in the browser.
# Defaults to ws://localhost:10000 if not set.
# In production, use your worker's public WebSocket URL (e.g., wss://pwnops-worker.example.com)
NEXT_PUBLIC_WORKER_WS_URL="ws://localhost:10000"

# ── Notifications (Optional) ─────────────────────────────
DISCORD_WEBHOOK_URL=""

# ── Registration Restrictions (Optional) ──────────────────
# Comma-separated list of allowed email domains for registration.
# If not set, any email domain can register.
# Example: ALLOWED_REGISTRATION_DOMAINS=yourcompany.com,partner.com
# ALLOWED_REGISTRATION_DOMAINS=""

# ── Seed Account Passwords (Required for first run) ───────
# Used when seeding the database for the first time via /api/seed.
# ⚠ Change these immediately after first login in any non-local environment.
SEED_ADMIN_PASSWORD="PwnOps!Admin#2026"
SEED_ANALYST_PASSWORD="PwnOps!Analyst#2026"
SEED_VIEWER_PASSWORD="PwnOps!Viewer#2026"

